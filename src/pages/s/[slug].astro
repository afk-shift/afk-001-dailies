---
import { withDevNarration } from '../../components/player/dev-narration';
import { formatDuration } from '../../components/player/format';
import { Player } from '../../components/player/Player';
import Base from '../../layouts/Base.astro';
import { resolveSupercut } from '../../lib/get-supercut';

const { slug } = Astro.params;

const resolved = slug ? await resolveSupercut(slug) : null;

// The demo fixture ships without narration, so development gets a stand-in to
// drive supercut mode against.
const supercut =
  import.meta.env.DEV && resolved ? withDevNarration(resolved) : resolved;

if (!supercut) {
  Astro.response.status = 404;
}

// `?at=<index>` deep links straight to a position in the reel, and `?cut=1`
// opens it in supercut mode. Resolving both on the server keeps the island's
// first paint identical to its hydrated state.
const requested = Number(Astro.url.searchParams.get('at'));
const initialIndex =
  supercut && Number.isFinite(requested)
    ? Math.min(
        Math.max(0, Math.trunc(requested)),
        Math.max(0, supercut.events.length - 1)
      )
    : 0;

const initialMode =
  Astro.url.searchParams.get('cut') === '1' ? 'supercut' : 'linear';

// `?live=1` follows a session that's still being written, and `?chrome=none`
// strips the site header and footer so the player owns the whole frame for a
// screen recording. Both are URL-only — nothing in the UI turns chrome off.
const initialLive = Astro.url.searchParams.get('live') === '1';
const chrome = Astro.url.searchParams.get('chrome') === 'none' ? 'none' : 'slim';

const count = (value: number, noun: string) =>
  `${value} ${value === 1 ? noun : `${noun}s`}`;

const title = supercut ? supercut.title || supercut.sessionId : '';
const description = supercut
  ? `${supercut.project} · ${count(supercut.stats.turns, 'turn')}, ${count(supercut.stats.toolCalls, 'tool call')}, ${count(supercut.stats.commits, 'commit')}, and ${count(supercut.stats.subagents, 'subagent')} in ${formatDuration(supercut.stats.durationMs)}.`
  : '';
---

{
  !supercut ? (
    <Base title="Not found">
      <section class="mx-auto flex max-w-5xl flex-col items-start px-6 py-24">
        <p class="font-mono text-xs tracking-widest text-accent uppercase">
          404
        </p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-paper">
          Supercut <span class="font-mono text-accent">{slug}</span> not found
        </h1>
        <p class="mt-4 max-w-md text-muted">
          This replay doesn't exist yet, or it hasn't been published. Check the
          link, or head back and watch the demo instead.
        </p>
        <a
          href="/"
          class="mt-8 inline-flex items-center gap-2 rounded-md border border-line px-4 py-2 font-mono text-sm text-paper transition-colors hover:border-accent/60"
        >
          &larr; back to dailies
        </a>
      </section>
    </Base>
  ) : (
    <Base
      title={title}
      description={description}
      ogTitle={title}
      wide
      chrome={chrome}
    >
      <Player
        supercut={supercut}
        initialIndex={initialIndex}
        initialMode={initialMode}
        initialLive={initialLive}
        client:load
      />
    </Base>
  )
}
