---
import Base from '../layouts/Base.astro';
import { getFeaturedSlug, getSupercut } from '../lib/store';

const DEMO_SLUG = 'demo';

// A distinct, real featured supercut — never the synthetic demo, which
// already has its own link in the hero above.
let featured: { slug: string; title: string } | null = null;
try {
  const slug = await getFeaturedSlug();
  if (slug && slug !== DEMO_SLUG) {
    const supercut = await getSupercut(slug);
    if (supercut) featured = { slug, title: supercut.title || supercut.sessionId };
  }
} catch (err) {
  // Blobs isn't available in every local dev setup — never 500 the
  // homepage over it, just hide the Featured section.
  console.error('Failed to load the featured supercut:', err);
}

const CLI_SNIPPET = `git clone git@github.com:seancdavis/surprise-me.git dailies && cd dailies && npm install
npm run dailies -- <sessionId>   # add --dry-run to preview first, nothing published`;

const steps = [
  {
    n: '01',
    title: 'Clone it and add your token',
    body: 'git clone this repo, npm install, then copy .env.example to .env and paste in a DAILIES_PUBLISH_TOKEN (see the README).',
  },
  {
    n: '02',
    title: 'Run the CLI on a session',
    body: 'npm run dailies -- <sessionId> parses a Claude Code transcript and publishes a supercut here. Add --dry-run first to preview it locally — nothing is sent over the network.',
  },
  {
    n: '03',
    title: 'Share the replay',
    body: 'Send the link. Anyone who opens it watches your session play back as an animated, scrubbable replay.',
  },
];
---

<Base>
  <section class="mx-auto max-w-5xl px-6 pb-20 pt-16 sm:pt-24">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">
      dailies
    </p>
    <h1
      class="mt-4 max-w-2xl text-4xl font-semibold tracking-tight text-paper sm:text-5xl"
    >
      Supercuts of your Claude Code sessions.
    </h1>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">
      Every session is a story — prompts, tool calls, files touched,
      commits made. Dailies turns the transcript into a tight, watchable
      replay you can send in one link.
    </p>
    <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row">
      <a
        href="/s/demo"
        class="inline-flex shrink-0 items-center gap-2 rounded-md bg-accent px-5 py-2.5 font-mono text-sm font-medium text-ink transition-colors hover:bg-accent-dim"
      >
        Watch the synthetic demo
      </a>
      <pre
        class="w-full max-w-xl overflow-x-auto rounded-md border border-line bg-ink-raised px-4 py-3 font-mono text-xs leading-relaxed text-muted"
      ><code>{CLI_SNIPPET}</code></pre>
    </div>
  </section>

  <section class="border-t border-line/60 bg-ink-raised/40">
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="font-mono text-xs tracking-widest text-muted uppercase">
        How it works
      </h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {
          steps.map((step) => (
            <div>
              <span class="font-mono text-sm text-accent">{step.n}</span>
              <h3 class="mt-2 text-lg font-medium text-paper">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {step.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="mx-auto max-w-5xl px-6 py-16">
        <h2 class="font-mono text-xs tracking-widest text-muted uppercase">
          Featured
        </h2>
        <a
          href={`/s/${featured.slug}`}
          class="mt-6 flex items-center justify-between gap-6 rounded-lg border border-line bg-ink-raised px-6 py-5 transition-colors hover:border-accent/60"
        >
          <div>
            <p class="font-mono text-xs text-accent">/s/{featured.slug}</p>
            <p class="mt-1 text-base font-medium text-paper">
              {featured.title}
            </p>
          </div>
          <span class="font-mono text-sm text-muted">&rarr;</span>
        </a>
      </section>
    )
  }
</Base>
