---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Social title, when it should differ from the page title. */
  ogTitle?: string;
  /** Widens the header and footer to match a full-width page like the player. */
  wide?: boolean;
  /**
   * `slim` hands the viewport to the page from `lg` up: a shorter site header,
   * no footer, and a shell that never scrolls. The page is then responsible
   * for filling that height.
   */
  chrome?: 'default' | 'slim';
}

const {
  title = 'Dailies',
  description = 'Supercuts of your Claude Code sessions.',
  ogTitle,
  wide = false,
  chrome = 'default',
} = Astro.props;

const pageTitle = title === 'Dailies' ? title : `${title} — Dailies`;
const socialTitle = ogTitle ?? pageTitle;
const gutter = wide
  ? 'mx-auto max-w-7xl px-4 sm:px-6'
  : 'mx-auto max-w-5xl px-6';
const slim = chrome === 'slim';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      slim && (
        <script is:inline>
          try {
            if (localStorage.getItem('dailies:slate') === 'collapsed') {
              document.documentElement.dataset.slate = 'collapsed';
            }
          } catch (error) {
            /* Storage is a nicety here. */
          }
        </script>
      )
    }
  </head>
  <body
    class:list={[
      'min-h-screen bg-ink font-sans antialiased',
      slim && 'lg:h-dvh lg:min-h-0 lg:overflow-hidden',
    ]}
  >
    <div
      class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(255,138,61,0.12),transparent)]"
    >
    </div>
    <div
      class:list={[
        'relative flex min-h-screen flex-col',
        slim && 'lg:h-full lg:min-h-0 lg:overflow-hidden',
      ]}
    >
      <header class="border-b border-line/60">
        <div
          class:list={[
            gutter,
            'flex items-center justify-between',
            slim ? 'py-3' : 'py-5',
          ]}
        >
          <a
            href="/"
            class="font-mono text-sm font-semibold tracking-tight text-paper"
          >
            <span class="text-accent">&gt;</span> dailies
          </a>
          <nav class="font-mono text-xs text-muted">
            <a href="/s/demo" class="transition-colors hover:text-paper"
              >demo</a
            >
          </nav>
        </div>
      </header>
      <main
        class:list={[
          'relative flex-1',
          slim && 'lg:flex lg:min-h-0 lg:flex-col',
        ]}
      >
        <slot />
      </main>
      <footer class:list={['border-t border-line/60', slim && 'lg:hidden']}>
        <div class:list={[gutter, 'py-6 font-mono text-xs text-muted']}>
          built with claude code
        </div>
      </footer>
    </div>
  </body>
</html>
