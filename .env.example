DAILIES_PUBLISH_TOKEN=
DAILIES_SITE_URL=

# Server-side kill switch for AI narration (set on the Netlify site, not
# locally): set to `off` to make /api/publish skip triggering
# /api/narrate entirely, regardless of what the client requests. Any other
# value (including unset) leaves narration enabled.
DAILIES_NARRATE=
